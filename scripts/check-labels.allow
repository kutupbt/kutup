# Literals starting "kutup/ or "kutup- in crate sources that are NOT
# cryptographic labels (names, headers, paths, test fixtures):
# scripts/check-labels.sh skips exactly these, by file and literal.
# A label goes in crates/kutup-crypto/src/labels.rs instead.
# Format: <path> TAB <literal as the check prints it> TAB <what it is>

crates/kutup-chat-core/src/db/indexed_db.rs	"kutup-chat-test-	test database name
crates/kutup-chat-core/src/db/indexed_db.rs	"kutup-chat-test-unkeyed-	test database name
crates/kutup-chat-core/src/db/sqlite.rs	"kutup-chat-	test database path
crates/kutup-chat-core/src/db/sqlite.rs	"kutup-chat-no-sqlcipher-	test database path
crates/kutup-chat-core/src/db/sqlite.rs	"kutup-chat-sqlcipher-	test database path
crates/kutup-chat-core/src/db/store_cipher.rs	"kutup-chat-v2:abc	test store id (an input, not a label)
crates/kutup-chat-core/src/db/store_cipher.rs	"kutup-chat-v2:other	test store id (an input, not a label)
crates/kutup-client-ffi/src/lib.rs	"kutup-chat-	thread name
crates/kutup-cli/src/session.rs	"kutup-cli/	keychain service name / test path
crates/kutup-cli/src/session.rs	"kutup-test-	keychain service name / test path
crates/kutup-cli/src/sshagent/service.rs	"kutup-ssh-agent.service	systemd unit name
crates/kutup-federation-proto/src/http_signatures.rs	"kutup-destination	HTTP header names (RFC 9421 covered components) / test of the registry tag
crates/kutup-federation-proto/src/http_signatures.rs	"kutup-federation-feature	HTTP header names (RFC 9421 covered components) / test of the registry tag
crates/kutup-federation-proto/src/http_signatures.rs	"kutup-federation-v2	HTTP header names (RFC 9421 covered components) / test of the registry tag
crates/kutup-federation-proto/src/http_signatures.rs	"kutup-federation-version	HTTP header names (RFC 9421 covered components) / test of the registry tag
crates/kutup-federation-proto/src/http_signatures.rs	"kutup-origin	HTTP header names (RFC 9421 covered components) / test of the registry tag
crates/kutup-server/src/auth_check.rs	"kutup-timing-only	bcrypt timing dummy
crates/kutup-server/src/auth_check.rs	"kutup-timing-only-not	bcrypt timing dummy
crates/kutup-server/src/config.rs	"kutup-files	log prefix / default bucket / test path
