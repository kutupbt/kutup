{
  "name": "kutup-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:crypto-wasm": "bash ../scripts/build-crypto-wasm.sh",
    "build:chat-wasm": "bash ../scripts/build-chat-wasm.sh",
    "build:wasm": "pnpm run build:crypto-wasm && pnpm run build:chat-wasm",
    "test:crypto-wasm": "node ../scripts/test-crypto-wasm.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "pnpm -r --filter './apps/*' run build",
    "dev:account": "pnpm -C apps/account dev",
    "dev:drive": "pnpm -C apps/drive dev",
    "dev:chat": "pnpm -C apps/chat dev",
    "dev:maps": "pnpm -C apps/maps dev",
    "dev:editor": "pnpm -C apps/editor dev",
    "dev:office": "pnpm -C apps/office dev"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.3",
    "jsdom": "^25",
    "@types/node": "^25.4.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "msw": "^2",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.0.16",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14",
      "esbuild": "^0.25.10",
      "@tiptap/extension-bubble-menu": "3.31.3",
      "@tiptap/extension-floating-menu": "3.31.3"
    },
    "patchedDependencies": {
      "@radix-ui/react-dismissable-layer@1.1.19": "patches/@radix-ui__react-dismissable-layer@1.1.19.patch",
      "@radix-ui/react-dismissable-layer@1.1.20": "patches/@radix-ui__react-dismissable-layer@1.1.20.patch"
    }
  }
}
