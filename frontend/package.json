{
  "name": "kutup-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:crypto-wasm": "bash ../scripts/build-crypto-wasm.sh",
    "build:chat-wasm": "bash ../scripts/build-chat-wasm.sh",
    "build:wasm": "pnpm run build:crypto-wasm && pnpm run build:chat-wasm",
    "test:crypto-wasm": "node ../scripts/test-crypto-wasm.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "pnpm -r --filter './apps/*' run build",
    "dev:account": "pnpm -C apps/account dev",
    "dev:drive": "pnpm -C apps/drive dev",
    "dev:chat": "pnpm -C apps/chat dev"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^4.1.5",
    "jsdom": "^25",
    "@types/node": "^25.4.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "msw": "^2",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.0.16"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14",
      "esbuild": "^0.25.10"
    }
  }
}
