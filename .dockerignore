# Build context for Dockerfile.server is the repo root, but the image only needs the Cargo
# workspace (Cargo.toml, Cargo.lock, crates/). Everything else is excluded to keep the
# context small/fast — most importantly the multi-GB target/ dir.
target/
.git/
**/node_modules/
# The frontend image uses the repo root so it can compile the WASM crates.
# Keep its sources in context while excluding generated and heavy assets.
frontend/wasm/
frontend/**/dist/
frontend/apps/office/public/onlyoffice/dist/
frontend/apps/office/public/onlyoffice/templates/
frontend/apps/office/public/onlyoffice/LICENSES/
frontend/apps/office/public/onlyoffice/FILES.sha512
frontend/apps/office/public/onlyoffice/SBOM.spdx.json
frontend/apps/office/public/onlyoffice/SOURCE.json
frontend/tsconfig.tsbuildinfo
src-tauri/
backend/
cmd/
nginx/
docs/
**/*.md
.env
.env.*
**/target/
