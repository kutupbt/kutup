# PostgreSQL
POSTGRES_DB=kutup
POSTGRES_USER=kutup
POSTGRES_PASSWORD=change_me_strong_password
CHAT_MAX_ACTIVE_DEVICES=10
CHAT_MEDIA_MAX_PLAINTEXT_BYTES=2147483648

# Group chats and group calls. Set to false for direct chats only: the server
# then reports no groups and refuses the group routes, and the apps hide
# them. Groups made earlier stay stored but cannot be opened.
CHAT_GROUPS=true

# Link previews: the server fetches public https pages (port 443, public
# addresses only) for the sender's previews. It then sees the links its users
# preview, never their messages. Set to false to turn previews off.
CHAT_LINK_PREVIEWS=true

# Web Push: wake Chat devices whose browser is closed. Pushes are empty (the
# server cannot read messages); the server sends them only to the push
# services listed (exact hosts, or .suffix for subdomains). The VAPID key is
# made once and kept in the database. Subject: a mailto: or https: contact.
CHAT_WEB_PUSH=true
# CHAT_WEB_PUSH_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,.push.apple.com,.notify.windows.com
# CHAT_WEB_PUSH_SUBJECT=mailto:admin@example.com

# Calls: media flows browser to browser (DTLS-SRTP). STUN finds public
# addresses; a TURN relay (coturn with use-auth-secret) carries calls that
# can't connect directly and hides addresses for "Always relay calls".
# The server hands out 12-hour credentials made with CHAT_TURN_SECRET.
# `docker compose --profile turn up` starts coturn with the same secret.
# The last address below is TURN over TLS on port 443, for networks that let
# nothing out but HTTPS: the bundled nginx takes it on turn.<domain> (which
# needs DNS and a place on the certificate) and hands it to coturn.
# CHAT_STUN_URLS=stun:turn.example.com:3478
# CHAT_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# CHAT_TURN_SECRET=<long random string>
# CHAT_TURN_REALM=turn.example.com

# Group calls: a LiveKit SFU (`docker compose --profile sfu up`). Browsers
# connect to CHAT_SFU_URL; the bundled nginx serves the SFU at
# wss://sfu.<domain>, which needs DNS and a place on the certificate. UDP
# 50000-60000 and TCP 7881 must be reachable. Frames are end-to-end
# encrypted, so the SFU forwards what it cannot read. Without these, accounts
# here can join group calls other servers host but not start one.
# CHAT_SFU_URL=wss://sfu.example.com
# CHAT_SFU_API_KEY=<key name>
# CHAT_SFU_API_SECRET=<32+ random characters>
# Group-call media over TLS on port 443, for the same networks: the name
# (sfu-turn.<domain>, with DNS and a place on the certificate) the SFU's own
# relay is offered under.
# CHAT_SFU_TURN_DOMAIN=sfu-turn.example.com
# Stable account suffix used even when federation is disabled. Set this once;
# enabling federation later requires FEDERATION_SERVER_NAME to match it.
CHAT_SERVER_NAME=kutup.local

# Web app origins. Kutup's web UI is six apps on their own origins (account,
# drive, chat, photos, maps, office) plus a keyless OnlyOffice sandbox at
# editor.<domain>. Set the base domain, or override any origin explicitly.
# Development without either falls back to the Vite dev hosts
# (http://account.localhost:5173 …); production refuses to start.
KUTUP_BASE_DOMAIN=kutup.example.org
# KUTUP_ACCOUNT_URL=https://account.kutup.example.org
# KUTUP_DRIVE_URL=https://drive.kutup.example.org
# KUTUP_CHAT_URL=https://chat.kutup.example.org
# KUTUP_OFFICE_URL=https://office.kutup.example.org
# KUTUP_EDITOR_URL=https://editor.kutup.example.org
# KUTUP_MAPS_URL=https://maps.kutup.example.org
# KUTUP_PHOTOS_URL=https://photos.kutup.example.org

# Automatic HTTPS certificates (docker-compose.acme.yml; docs/self-hosting.md).
# KUTUP_ACME_EMAIL=you@example.org      # optional: Let's Encrypt expiry warnings
# KUTUP_ACME_DOMAINS=                   # optional: names other than the six app hostnames
# KUTUP_ACME_EXTRA_DOMAINS=sfu.kutup.example.org   # optional: names beside the six
# KUTUP_ACME_STAGING=1                  # untrusted test certificates

# Encrypted database backups to the object store (scripts/backup-postgres.sh;
# docs/self-hosting.md, "Database backups"). Keep a copy of the passphrase
# somewhere other than this machine.
# KUTUP_BACKUP_PASSPHRASE=<openssl rand -hex 32>
# KUTUP_BACKUP_KEEP_DAYS=30

# JWT - generate with: openssl rand -hex 64
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64

# Object storage. These are the bundled SeaweedFS's credentials by default.
# To use another S3-compatible store (Cloudflare R2, Backblaze B2, Hetzner,
# MinIO, AWS S3, …) set S3_ENDPOINT to its S3 API address, put its key,
# bucket and region here, and start with docker-compose.external-s3.yml
# (docs/self-hosting.md, "Using another S3 store").
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=kutup
S3_SECRET_KEY=change_me_s3_secret
S3_BUCKET=kutup-files
S3_REGION=us-east-1

# SeaweedFS master endpoint — the admin dashboard probes it for real
# storage capacity + usage. Default works for the bundled docker-compose.
# Leave blank to disable the probe (the admin UI then falls back to
# STORAGE_TOTAL_BYTES below).
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333

# Fallback total storage capacity for the admin UI, in bytes — used only
# when the SeaweedFS probe above is unavailable. Leave unset / 0 to hide
# the capacity readout. Examples:
#   100 GB = 107374182400
#   500 GB = 536870912000
#     1 TB = 1099511627776
# STORAGE_TOTAL_BYTES=536870912000

# Days a trashed file/folder stays restorable before the hourly sweeper
# purges it permanently. 0 disables the automatic purge. Default: 30.
# TRASH_RETENTION_DAYS=30

# Chat mailbox ciphertext, temporary media-delivery, idempotency retention,
# and inactive-device expiry. Each is enforced hourly; 0 disables that policy.
# CHAT_MAILBOX_RETENTION_DAYS=30
# CHAT_SEND_RETENTION_DAYS=30
# CHAT_MEDIA_DELIVERY_RETENTION_DAYS=45
# CHAT_DEVICE_EXPIRY_DAYS=90

# Rate limits (per client IP; defaults shown). The backend resolves the client
# IP from the proxy-set X-Real-IP header — keep the backend unreachable except
# through nginx or these limits key on the proxy's address.
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_PREFLIGHT_PER_MIN=20
# RATE_LIMIT_FORK_PER_MIN=120           # each app opened redeems one session hand-off
# RATE_LIMIT_CALL_LINK_PER_MIN=60       # opening and joining a meeting link need no account
# RATE_LIMIT_CALL_LINK_POLL_PER_MIN=600 # a meeting's waiting room, asked about every few seconds
# RATE_LIMIT_USER_LOOKUP_PER_MIN=30
# RATE_LIMIT_REGISTER_PER_HOUR=10
# RATE_LIMIT_RECOVERY_PER_HOUR=5
# RATE_LIMIT_FED_USERS_PER_MIN=60
# RATE_LIMIT_ADMIN_PER_MIN=120
# RATE_LIMIT_CHAT_KEYS_PER_MIN=30       # per authenticated account
# RATE_LIMIT_CHAT_KEYS_IP_PER_MIN=120   # coarse outer IP wall

# Per-account login lockout: N failed password attempts lock the email out
# for the cooldown (defaults shown).
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15

# App
APP_ENV=production

# Optional OpenTelemetry export over OTLP/gRPC. Leave all endpoints unset for
# logs-only operation. Use either one shared endpoint or configure both
# signal-specific endpoints; a partial exporter configuration fails startup.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://collector.example.com:4317
# OTEL_SERVICE_NAME=kutup-server

# Public base URL of this server — published as the federation API base
# Set to your actual domain, e.g. https://kutup.example.com
SERVER_URL=http://kutup.local

# Port kutup-server listens on (default 3000).
# PORT=3000

# Unified federation v2 identity. Chat uses this shared identity, resolver,
# trust store, admission policy, and signed transport. Optional: without it the
# server makes its own on first start, named after CHAT_SERVER_NAME and kept in
# the database (docs/self-hosting.md). To manage the seed yourself, generate it
# once (`openssl rand -base64 32`), store it as a secret, and back it up.
# FEDERATION_SERVER_NAME=kutup.example.com
# FEDERATION_SIGNING_KEY=
# FEDERATION_NEXT_SIGNING_KEY=  # set only while running the rotation command

# Active Chat installations per account. V1 permits 1..=10.
CHAT_MAX_ACTIVE_DEVICES=10
CHAT_MEDIA_MAX_PLAINTEXT_BYTES=2147483648

# Sealed sender remains unadvertised unless both values are present and valid.
# The policy contains public offline roots and root-signed online certificates;
# never place an offline root private key on the application server.
CHAT_SEALED_SENDER_POLICY=
CHAT_SEALED_SENDER_ONLINE_PRIVATE_KEY=

# Private MLS groups work without these: the server orders them with a control
# key it makes (kept in the database) and the standard v1 policy. Set both only
# to publish a custom policy for this server's identity. Federation admission
# decides which other servers members may come from; it never hides groups.
CHAT_MLS_ORDERING_POLICY=
CHAT_MLS_CONTROL_SIGNING_KEY=

# Break-glass admin bootstrap — a single email:username:password triple.
# Created on first server start; the admin completes setup on first login.
# This account is the protected break-glass admin: it can never be demoted,
# disabled, or deleted via the API/UI, so the server maintainer always has
# a working admin. Promote additional admins from inside the app.
ADMIN_ACCOUNT=admin@example.com:admin:change_me_admin_password
