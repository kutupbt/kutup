# Kutup server settings. Copy to .env next to docker-compose.yml:
#
#   cp .env.example .env
#
# Fill in the REQUIRED block, then start (docs/self-hosting.md, "Quick start").
# Everything after it is optional: each line shows the default, commented out.
# `docker compose run --rm --no-deps backend check-config` checks the whole file
# without starting anything; a value the server cannot read stops it with every
# problem listed.

# =============================================================================
# REQUIRED
# =============================================================================

# Your domain. The apps live on account., drive., chat., photos., maps.,
# office., contacts., mail., pass. and editor.<domain>; point each name at
# this machine and put it on the certificate.
KUTUP_BASE_DOMAIN=example.org

# This server's public HTTPS address (federation and links are built from it).
SERVER_URL=https://example.org

# The name after the @ in every address (alice@example.org). Set it once,
# before the first account: changing it later is a migration, not an edit.
CHAT_SERVER_NAME=example.org

# The database password. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs sessions. Generate: openssl rand -hex 64
JWT_SECRET=

# The keys sign-in (OPAQUE) is sealed under. Generate: echo "1:$(openssl rand -base64 32)"
# Back it up apart from the database: losing it means every account signs in
# again with its recovery phrase. To rotate, append a key with a higher id.
OPAQUE_SETUP_KEYS=

# The bundled object store's secret. Generate: openssl rand -hex 32
S3_SECRET_KEY=

# The break-glass administrator, username:password (the password may hold
# colons). Made on first start; it can never be demoted, disabled or deleted.
ADMIN_ACCOUNT=admin:

# =============================================================================
# OPTIONAL: General
# =============================================================================

# production, development or test.
# APP_ENV=production
# Who may sign up on a fresh database: on, code (an administrator's referral
# code) or off. Read only until the administrators choose under Server settings.
# REGISTRATION_MODE=off
# Each app's address when it is not <app>.KUTUP_BASE_DOMAIN.
# KUTUP_ACCOUNT_URL=https://account.example.org
# KUTUP_DRIVE_URL=https://drive.example.org
# KUTUP_CHAT_URL=https://chat.example.org
# KUTUP_OFFICE_URL=https://office.example.org
# KUTUP_EDITOR_URL=https://editor.example.org
# KUTUP_MAPS_URL=https://maps.example.org
# KUTUP_PHOTOS_URL=https://photos.example.org
# KUTUP_CONTACTS_URL=https://contacts.example.org
# KUTUP_MAIL_URL=https://mail.example.org
# KUTUP_PASS_URL=https://pass.example.org
# Host ports the bundled nginx listens on (80 and 443 with docker-compose.acme.yml).
# KUTUP_HTTP_PORT=38080
# KUTUP_HTTPS_PORT=38443
# Where feedback from the apps can be forwarded as a public issue: owner/repo or off.
# FEEDBACK_GITHUB_REPOSITORY=kutupbt/kutup

# =============================================================================
# OPTIONAL: Automatic certificates (docker-compose.acme.yml)
# =============================================================================

# Let's Encrypt expiry warnings go here.
# KUTUP_ACME_EMAIL=
# Names to certify instead of the app hostnames.
# KUTUP_ACME_DOMAINS=
# Names to certify beside them (sfu., turn., mail., openpgpkey.<domain>, …).
# KUTUP_ACME_EXTRA_DOMAINS=
# 1: untrusted test certificates, for trying the setup.
# KUTUP_ACME_STAGING=

# =============================================================================
# OPTIONAL: Database and storage
# =============================================================================

# The bundled PostgreSQL's database and user.
# POSTGRES_DB=kutup
# POSTGRES_USER=kutup
# Another S3-compatible store (R2, B2, Hetzner, MinIO, AWS) instead of the
# bundled SeaweedFS: its API address, with docker-compose.external-s3.yml.
# S3_ENDPOINT=http://seaweedfs-s3:8333
# S3_ACCESS_KEY=kutup
# S3_BUCKET=kutup-files
# S3_REGION=us-east-1
# SeaweedFS master the admin dashboard asks for capacity; blank turns it off.
# SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
# Capacity shown when that probe is off, in bytes (0 hides it).
# STORAGE_TOTAL_BYTES=0
# Days a trashed item stays restorable (0 keeps it until emptied).
# TRASH_RETENTION_DAYS=30
# Encrypted database backups (scripts/backup-postgres.sh): the passphrase
# (keep a copy elsewhere) and how many days of backups to keep.
# KUTUP_BACKUP_PASSPHRASE=
# KUTUP_BACKUP_KEEP_DAYS=30

# =============================================================================
# OPTIONAL: Chat
# =============================================================================

# Group chats and group calls: off until the new group design replaces them.
# CHAT_GROUPS=false
# The most members (and open invitations) a group hosted here may have (1 to 256).
# CHAT_GROUP_MAX_MEMBERS=256
# The most groups this server hosts.
# CHAT_GROUP_MAX_GROUPS=100000
# Sealed Chat federation: flush locks held at once, each one Postgres session
# beside the main pool (1-64). Session advisory locks: not behind PgBouncer in
# transaction mode (docs/self-hosting.md).
# SEALED_FLUSH_LOCK_CONNECTIONS=4
# Link previews: the server fetches public https pages for the sender.
# CHAT_LINK_PREVIEWS=true
# Chat installations one account may have (1 to 10).
# CHAT_MAX_ACTIVE_DEVICES=10
# Largest attachment, in bytes (at most 2147483648).
# CHAT_MEDIA_MAX_PLAINTEXT_BYTES=2147483648
# Days kept: undelivered messages, send records, delivery copies of media,
# and devices not seen (0 turns that one off). Administrators can change the
# first and third under Admin → Settings.
# CHAT_MAILBOX_RETENTION_DAYS=30
# CHAT_SEND_RETENTION_DAYS=30
# CHAT_MEDIA_DELIVERY_RETENTION_DAYS=45
# CHAT_DEVICE_EXPIRY_DAYS=90
# Web Push wakes closed browsers with empty pushes, only to these services
# (exact hosts, or .suffix); the subject is a mailto: or https: contact.
# CHAT_WEB_PUSH=true
# CHAT_WEB_PUSH_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,.push.apple.com,.notify.windows.com
# CHAT_WEB_PUSH_SUBJECT=
# Sealed sender from an offline root, both or neither (blank: the server
# provisions it itself). Never put the offline root's private key here.
# CHAT_SEALED_SENDER_POLICY=
# CHAT_SEALED_SENDER_ONLINE_PRIVATE_KEY=
# A custom MLS ordering policy, both or neither (blank: the standard policy
# with a control key the server makes).
# CHAT_MLS_ORDERING_POLICY=
# CHAT_MLS_CONTROL_SIGNING_KEY=

# =============================================================================
# OPTIONAL: Calls
# =============================================================================

# STUN and TURN (`docker compose --profile turn up` starts coturn). The
# server hands out 12-hour TURN credentials made with the shared secret.
# CHAT_STUN_URLS=stun:turn.example.org:3478
# CHAT_TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp,turns:turn.example.org:443?transport=tcp
# CHAT_TURN_SECRET=
# CHAT_TURN_REALM=kutup
# The server's own public addresses, which the relay must never reach
# (coturn runs on the host network): comma-separated, ranges as a-b.
# CHAT_TURN_DENIED_PEER_IPS=203.0.113.7,2001:db8:1:2::-2001:db8:1:2:ffff:ffff:ffff:ffff
# Group calls on a LiveKit SFU (`docker compose --profile sfu up`), served at
# wss://sfu.<domain>. Without it, people here join others' group calls but
# cannot start one.
# CHAT_SFU_URL=wss://sfu.example.org
# Where the server reaches the SFU's API (blank: CHAT_SFU_URL; the bundled
# LiveKit: http://host.docker.internal:7880), and its key.
# CHAT_SFU_API_URL=
# CHAT_SFU_API_KEY=
# CHAT_SFU_API_SECRET=
# The SFU's relay over TLS on port 443 (sfu-turn.<domain>, on the certificate).
# CHAT_SFU_TURN_DOMAIN=

# =============================================================================
# OPTIONAL: Mail (docker-compose.mail.yml; docs/self-hosting.md, "Mail")
# =============================================================================

# The name the server's PTR record gives (mail.<domain>); add it to
# KUTUP_ACME_EXTRA_DOMAINS.
# MAIL_HOSTNAME=
# Custom domains' DNS checks ask this nameserver (ip:port), else the
# system's; the server validates DNSSEC itself.
# MAIL_DNS_RESOLVER=
# MAIL_DNS_INSECURE=false         # test stacks only (APP_ENV=test)
# MAIL_DOMAINS_SWEEP_SECONDS=300  # how often custom domains are checked and synced
# MAIL_DOMAINS_TIME_SCALE=1       # test stacks only: custom domains' periods divided by it
# A backup MX you run for custom domains, if any.
# MAIL_BACKUP_MX=
# Custom domains: Stalwart's management API and a key that may manage only
# domains and DKIM signatures (docs/self-hosting.md). Without the key,
# custom domains are off.
# MAIL_STALWART_URL=http://stalwart:8080
# MAIL_STALWART_DOMAINS_TOKEN=
# The keys custom domains' DKIM keys are sealed under, as MAIL_FORWARDING_KEYS
# (1:$(openssl rand -base64 32)). Without them, custom domains are off.
# MAIL_DKIM_KEYS=
# Shared with Stalwart. Generate each: openssl rand -hex 32
# MAIL_INBOUND_TOKEN=
# STALWART_ADMIN_SECRET=
# Host port Stalwart receives mail on.
# MAIL_SMTP_PORT=25
# Mail forwarding's keys: id:base64 of 32 random bytes
# (1:$(openssl rand -base64 32)); add 2:... to rotate (the highest seals).
# They seal end-to-end forwarding's proxy factors and sign outside
# forwarding's return paths and loop markers. Back them up with the
# database: without its key an end-to-end forwarding stops (Outdated) until
# its owner re-enables it. Unset: no forwarding of either kind.
# MAIL_FORWARDING_KEYS=
# Who may send to outside addresses at first: off, admins or on. Read once;
# afterwards Administration → Mail sending decides.
# MAIL_OUTSIDE_SENDING=off
# Outside recipients one account may send to.
# MAIL_SEND_RECIPIENTS_PER_HOUR=100
# MAIL_SEND_RECIPIENTS_PER_DAY=500
# A new account's first days, and its outside recipients a day then.
# MAIL_NEW_ACCOUNT_DAYS=7
# MAIL_NEW_ACCOUNT_RECIPIENTS_PER_DAY=50
# What one account may make: folders, labels, filters switched on, and
# block/spam/allow entries.
# MAIL_FOLDERS_PER_ACCOUNT=500
# MAIL_LABELS_PER_ACCOUNT=500
# MAIL_FILTERS_PER_ACCOUNT=200
# MAIL_SENDER_RULES_PER_ACCOUNT=5000
# Messages one step of a select-all change touches.
# MAIL_BATCH_CHUNK=5000
# Undo send's delay for accounts that chose none: 0, 5, 10 or 20 seconds.
# MAIL_DEFAULT_DELAY_SEND_SECONDS=10

# =============================================================================
# OPTIONAL: Names and federation
# =============================================================================

# A name left by a rename or deletion stays held this many days; a renamed
# account's old address receives for the second number of days. Both seed
# what administrators set under Administration.
# NAME_HOLD_DAYS=180
# OLD_ADDRESS_RECEIVE_DAYS=90
# How often, in seconds, those dates are acted on.
# NAME_SWEEP_SECONDS=3600
# The federation identity. Blank: the server makes one named after
# CHAT_SERVER_NAME and keeps it in the database. To manage the seed yourself:
# openssl rand -base64 32, stored as a secret and backed up.
# FEDERATION_SERVER_NAME=
# FEDERATION_SIGNING_KEY=
# Only while running the key rotation command.
# FEDERATION_NEXT_SIGNING_KEY=

# =============================================================================
# OPTIONAL: Rate limits and sign-in lockout
# =============================================================================

# Per client IP, or per account where noted. The server takes the client IP
# from nginx's X-Real-IP: reach the backend only through nginx. Each sets a
# limit's first value only: administrators change every limit under
# Administration -> Rate limits, which wins, without a restart. An unknown
# RATE_LIMIT_* name, or a value above 100 times the default, stops the server.
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_PREFLIGHT_PER_MIN=20                      # retired; limits nothing
# RATE_LIMIT_FORK_PER_MIN=120                          # each app opened takes one
# RATE_LIMIT_USER_LOOKUP_PER_MIN=30                    # per account
# RATE_LIMIT_REGISTER_PER_HOUR=10
# RATE_LIMIT_REGISTRATION_CODE_CHECK_PER_HOUR=30
# RATE_LIMIT_REGISTRATION_CODE_FAILURES_PER_HOUR=20
# RATE_LIMIT_RECOVERY_PER_HOUR=5
# RATE_LIMIT_REPORT_PER_HOUR=20                        # reporting a public link
# RATE_LIMIT_MAIL_DOMAIN_CHECKS_PER_HOUR=30            # a custom domain's "Refresh status"
# RATE_LIMIT_FEEDBACK_PER_HOUR=10                      # per account
# RATE_LIMIT_ADMIN_PER_MIN=120
# RATE_LIMIT_FED_USERS_PER_MIN=60                      # per other server
# RATE_LIMIT_FED_MULTI_FAILURES_PER_MIN=60         # forwarded group sends that fail authentication, per address
# RATE_LIMIT_CALL_LINK_PER_MIN=60                      # meeting links need no account
# RATE_LIMIT_CALL_LINK_POLL_PER_MIN=600                # a meeting's waiting room
# RATE_LIMIT_CHAT_KEYS_PER_MIN=30                      # per account
# RATE_LIMIT_CHAT_KEYS_IP_PER_MIN=120
# RATE_LIMIT_CHAT_ANONYMOUS_IP_PER_MIN=60              # sealed and anonymous sends
# RATE_LIMIT_AVAILABLE_HASHES_PER_MIN=120              # per account
# RATE_LIMIT_COLLAB_FRAME_POSTS_PER_MIN=600            # per device
# RATE_LIMIT_DEVICE_CHALLENGES_PER_MIN=20              # per account
# RATE_LIMIT_ACCOUNT_HEAD_READS_PER_MIN=300            # per account
# RATE_LIMIT_RENAME_CHECKS_PER_15_MIN=30               # per account
# RATE_LIMIT_RENAME_LOOKUPS_PER_15_MIN=60              # per account
# RATE_LIMIT_RENAME_PEER_FETCHES_PER_MIN=120           # per other server
# RATE_LIMIT_ACCOUNT_PEER_FETCHES_PER_MIN=120          # per account and other server
# RATE_LIMIT_RENAME_ANNOUNCES_PER_MIN=600              # per other server
# RATE_LIMIT_COLLAB_DEVICE_ANNOUNCES_PER_MIN=60        # per other server and share
# RATE_LIMIT_CHAT_GROUP_RELAY_PER_MIN=240              # group requests relayed, per account
# RATE_LIMIT_CHAT_GROUP_GATEWAY_RELAY_PER_MIN=6000     # group requests, per relaying server
# RATE_LIMIT_CHAT_GROUP_PSEUDONYM_PER_MIN=240          # group requests, per member pseudonym
# RATE_LIMIT_CHAT_GROUP_CHANGES_PSEUDONYM_PER_MIN=30   # group changes, per member pseudonym
# RATE_LIMIT_CHAT_GROUP_CHANGES_GROUP_PER_MIN=60       # group changes, per group
# RATE_LIMIT_CHAT_GROUP_LINK_PER_MIN=30                # link join info, per group
# RATE_LIMIT_CHAT_GROUP_LINK_JOINS_RELAY_GROUP_PER_MIN=120  # link joins and requests, per relay server and group (first value; admins set it)
# RATE_LIMIT_CHAT_GROUP_LINK_JOINS_RELAY_PER_MIN=1200        # the same per relay server, all groups (first value; admins set it)
# RATE_LIMIT_CHAT_GROUP_FAILURES_RELAY_PER_MIN=600     # failed group requests, per relaying server
# RATE_LIMIT_CHAT_GROUP_CREATES_RELAY_PER_HOUR=600     # new groups, per relaying server
# Wrong passwords for one account from one client before that pair waits, and for how long.
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15
# Wrong passwords for one account from clients it does not know: per 15 minutes, per day.
# LOGIN_ACCOUNT_CEILING=20
# LOGIN_ACCOUNT_DAILY_CEILING=200
# Wrong passwords one unknown client may try a day, across accounts.
# LOGIN_SOURCE_DAILY_CEILING=20

# =============================================================================
# OPTIONAL: Monitoring
# =============================================================================

# OpenTelemetry over OTLP/gRPC: one shared endpoint, or both signal endpoints.
# Unset: logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_SERVICE_NAME=kutup-server

# =============================================================================
# OPTIONAL: Published images (docker-compose.images.yml, scripts/publish-images.sh)
# =============================================================================

# KUTUP_SERVER_IMAGE=
# KUTUP_WEB_IMAGE=
# KUTUP_STALWART_SETUP_IMAGE=

# =============================================================================
# ADVANCED: running the server outside Compose, and test stacks
# =============================================================================

# Compose sets these itself; set them only for a server you run another way.
# DATABASE_URL=postgres://kutup:<password>@localhost:5432/kutup?sslmode=disable
# PORT=3000
# MAPS_CACHE_DIR=
# MAIL_LMTP_BIND=0.0.0.0:2424
# MAIL_SUBMISSION_ADDR=stalwart:2587
# OPAQUE_SETUP_KEYS from a file (a mounted secret) instead; not both.
# OPAQUE_SETUP_KEYS_FILE=
# Browser origins allowed to call the API across origins.
# ALLOWED_ORIGINS=https://localhost:38443
# Test stacks only (APP_ENV=test): raise every rate limit, let federation
# reach private addresses, and fetch outside mail keys from a test server.
# RATE_LIMITS_RELAXED=false
# FEDERATION_TEST_ALLOW_PRIVATE=false
# MAIL_TEST_KEY_ORIGIN=
